# ------------------------------------------------------------------------------
# ClipForge AI - Environment Variables Template
# Copy this file to .env or .env.local and fill in the values.
# ------------------------------------------------------------------------------

# 1. Clerk Authentication Configuration
# Sign up at https://clerk.com to get your keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# 2. Neon PostgreSQL Database Configuration
# Create a serverless Postgres database at https://neon.tech.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 3. AWS Configuration (Used for original video storage and Remotion rendering)
# Create an IAM User with S3 and Lambda permissions.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_BUCKET_NAME=clipforge-project

# 4. Deepgram Audio Transcription API
# Sign up at https://deepgram.com to obtain an API key for high-speed speech-to-text.
DEEPGRAM_API_KEY=your_deepgram_api_key

# 5. Google Gemini AI API
# Generate an API key from Google AI Studio (https://aistudio.google.com) to drive viral clipping and post description generation.
GEMINI_API_KEY=your_gemini_api_key

# 6. Arcjet Security Engine
# Sign up at https://arcjet.com to obtain a key for WAF, Bot detection, and API rate-limiting.
ARCJET_KEY=ajkey_your_arcjet_license_key

# 7. Remotion Lambda Configuration
# These are generated after running the Remotion Lambda deployment commands:
# - npx remotion lambda sites create remotion/index.ts --site-name=clipforge-site
# - npx remotion lambda functions ls
REMOTION_SERVE_URL=https://remotionlambda-yourregion-uniqueid.s3.your-region.amazonaws.com/sites/clipforge-site/index.html
REMOTION_BUCKET_NAME=remotionlambda-yourregion-uniqueid
REMOTION_FUNCTION_NAME=remotion-render-4-0-465-mem2048mb-disk2048mb-120sec

# 8. Zernio API Configuration
# Get a developer API key from Zernio (https://zernio.com) for social media profile auth and cross-posting.
ZERNIO_API_KEY=sk_your_zernio_api_key

# 9. Redis Cache Configuration (Optional)
# Set your Redis connection URL (e.g. from Upstash or a local Redis instance).
# If not provided, caching will fall back to an in-memory Map cache.
REDIS_URL=redis://localhost:6379
