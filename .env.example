# ------------------------------------------------------------------------------
# ClipForge AI - Environment Variables Template
# Copy this file to .env.local and fill in the values.
# ------------------------------------------------------------------------------

# 1. Clerk Authentication Configuration
# Sign up at https://clerk.com to get your keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# 2. Neon PostgreSQL Database Configuration
# Create a serverless Postgres database at https://neon.tech.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 3. AWS — user-uploaded source videos (private S3 bucket + CORS)
# Create a dedicated bucket (NOT the Remotion bucket). Same region everywhere.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_BUCKET_NAME=clipforge-project

# 4. Deepgram Audio Transcription API
# Sign up at https://deepgram.com to obtain an API key for high-speed speech-to-text.
DEEPGRAM_API_KEY=your_deepgram_api_key

# 5. Groq AI API
# Generate an API key from Groq Console (https://console.groq.com).
# Used for viral clipping (llama-3.3-70b-versatile) and post caption generation.
GROQ_API_KEY=your_groq_api_key

# 6. Arcjet Security Engine
# Sign up at https://arcjet.com to obtain a key for WAF, Bot detection, and API rate-limiting.
ARCJET_KEY=ajkey_your_arcjet_license_key

# 7. Remotion Lambda (DIFFERENT bucket from AWS_BUCKET_NAME)
# Must use the SAME region as AWS_REGION.
# Deploy:
#   npx remotion lambda functions deploy --region=eu-north-1 --memory=3008 --disk=2048 --timeout=240
#   npx remotion lambda sites create remotion/index.ts --site-name=clipforge-site --region=eu-north-1
#   npx remotion lambda functions ls --region=eu-north-1
#   npx remotion lambda sites ls --region=eu-north-1
# Redeploy the site after any change under remotion/.
REMOTION_SERVE_URL=https://remotionlambda-eunorth1-xxxxx.s3.eu-north-1.amazonaws.com/sites/clipforge-site/index.html
REMOTION_BUCKET_NAME=remotionlambda-eunorth1-xxxxx
REMOTION_FUNCTION_NAME=remotion-render-4-0-469-mem3008mb-disk2048mb-240sec

# 8. Zernio API Configuration
# Get a developer API key from Zernio (https://zernio.com) for social media profile auth and cross-posting.
ZERNIO_API_KEY=sk_your_zernio_api_key

# 9. Redis Cache Configuration (Optional)
# Set your Redis connection URL (e.g. from Upstash or a local Redis instance).
# Leave unset if Redis is not running — the app falls back to in-memory cache.
# REDIS_URL=redis://localhost:6379

# 10. Inngest Background Jobs
# Local: set INNGEST_DEV=1 and run: npm run dev:inngest
INNGEST_DEV=1
# Production (Inngest Cloud): unset INNGEST_DEV and set keys from https://app.inngest.com
# INNGEST_EVENT_KEY=your_inngest_event_key
# INNGEST_SIGNING_KEY=your_inngest_signing_key
